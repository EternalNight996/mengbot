# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=mengbot
MB_BIND_ADDRESS=127.0.0.1
MB_HTTP_PORT=8080
# Leave empty to use http://localhost:${MB_HTTP_PORT:-8080}.
MB_PUBLIC_URL=
# Leave empty to inherit MB_PUBLIC_URL.
MB_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set MB_PUBLIC_URL to https:// followed by the same hostname.
# Requires MB_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
MB_HTTPS_HOST=
MB_BASE_IMAGE=mengbot:latest
MB_LOCAL_IMAGE=mengbot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
MB_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
MB_DATA_EXTERNAL=false

